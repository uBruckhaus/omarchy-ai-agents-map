 "security": {
  "settings": [
   {
    "key": "approval_policy",
    "title": "When Codex asks",
    "explain": "When Codex stops and asks before running a command.",
    "choices": [
     {
      "value": "untrusted",
      "label": "Ask for everything but safe reads",
      "explain": "Asks before every command that is not a known read-only one.",
      "risk": 0
     },
     {
      "value": "on-request",
      "label": "When it needs more",
      "explain": "Works inside the sandbox on its own and asks when it needs to leave it.",
      "risk": 1
     },
     {
      "value": "on-failure",
      "label": "After a failure (old)",
      "explain": "Asks only when a sandboxed command failed. Replaced by “When it needs more”.",
      "risk": 1
     },
     {
      "value": "never",
      "label": "Never",
      "explain": "Never asks; what the sandbox allows simply happens.",
      "risk": 2
     }
    ],
    "current": "never",
    "default": "on-request",
    "path": "~/.codex/config.toml",
    "fmt": "toml",
    "terms": [
     "approval"
    ],
    "editable": true,
    "recommended": "on-request",
    "warn": []
   },
   {
    "key": "sandbox_mode",
    "title": "Sandbox",
    "explain": "What commands Codex runs may touch.",
    "choices": [
     {
      "value": "read-only",
      "label": "Read only",
      "explain": "Commands may read, not write or go online.",
      "risk": 0
     },
     {
      "value": "workspace-write",
      "label": "Project folder",
      "explain": "Commands may write in the project folder (and temp), nowhere else.",
      "risk": 1
     },
     {
      "value": "danger-full-access",
      "label": "No sandbox",
      "explain": "Commands may do anything you can do.",
      "risk": 3
     }
    ],
    "current": null,
    "default": "workspace-write",
    "path": "~/.codex/config.toml",
    "fmt": "toml",
    "terms": [
     "sandbox"
    ],
    "editable": true,
    "recommended": "workspace-write",
    "warn": []
   },
   {
    "key": "sandbox_workspace_write.network_access",
    "title": "Network in the sandbox",
    "explain": "Whether commands in the project-folder sandbox may reach the internet.",
    "choices": [
     {
      "value": false,
      "label": "Off",
      "explain": "No internet for commands (web search of Codex itself still works).",
      "risk": 0
     },
     {
      "value": true,
      "label": "On",
      "explain": "Commands may download and upload.",
      "risk": 2
     }
    ],
    "current": true,
    "default": false,
    "path": "~/.codex/config.toml",
    "fmt": "toml",
    "terms": [
     "network"
    ],
    "editable": true,
    "recommended": false,
    "warn": []
   }
